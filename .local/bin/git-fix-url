#!/usr/bin/env bash
#
# Translates github public https: URLs to private SSH ones.

set -eu

if [ $# -gt 0 ]; then
    remotes="$@"
else
    remotes=$(git remote)
fi

for r in $remotes; do
    url=$(git remote get-url "$r")
    fixed_url=
    case "$url" in
        https://github.com/*)
            fixed_url="git@github.com:${url:19}"
            ;;
        https://bitbucket.org/*)
            fixed_url="git@bitbucket.org:${url:22}"
            ;;
    esac
    if [ "$fixed_url" != "" ]; then
        git remote set-url "$r" "$fixed_url" && \
            echo "Fixed remote $r to $fixed_url"
    fi
done
