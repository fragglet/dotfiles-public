! transformed with: fbthemecolor s-1.0 v-50
*button.pressed: sunken solid
*button.pressed.backgroundColor: darkgrey
*button: parentrelative
*button.foregroundColor: black

*borderColor: black
*borderWidth: 1
*marginWidth: 2

menu.bullet: triangle
menu.bullet.position: right

menu.title: raised border
menu.title.color: rgb:1e/1e/1e
menu.title.font: lucidasans-12:bold
menu.title.textColor: rgb:cd/cd/cd
menu.title.justify: center
menu.titleHeight: 25
menu.itemHeight: 20

menu.frame: raised border
menu.frame.textColor: black
menu.frame.color: rgb:9a/9a/9a
!menu.frame.foregroundColor: grey40
!menu.frame.disabledColor: darkgrey
menu.frame.justify: left

menu.hilite:                         Flat
menu.hilite.color:                   rgb:1e/1e/1e
menu.hilite.textColor:               rgb:cd/cd/cd

background: solid
background.color: rgb:48/48/48

slit.appearance: raised solid
slit*backgroundColor: rgb:60/60/60
slit.marginWidth: 2

toolbar: Raised
toolbar.height: 28
toolbar.workspace: Flat
toolbar.workspace.borderColor: rgb:60/60/60
toolbar.workspace.borderWidth: 10
toolbar.iconbar.focused: Raised
toolbar.iconbar.focused.color: rgb:1e/1e/1e
toolbar.iconbar.focused.textColor: white
toolbar.iconbar.unfocused: Raised
toolbar.iconbar.empty: Raised
toolbar.clock: Raised
toolbar.borderWidth: 1
toolbar.justify: center
toolbar*color: rgb:60/60/60
toolbar*textColor: black
toolbar*button: Raised
toolbar*button.color: rgb:46/46/46
toolbar.clock.color: rgb:60/60/60
toolbar.shaped: true

window.label.marginWidth: 1

window.title.focus: Raised
window.title.focus.color: rgb:1e/1e/1e
window.label.focus.font: lucidasans-12:bold
window.label.focus: Flat
window.label.focus.color: rgb:1e/1e/1e
window.label.focus.textColor: white
window.button.focus.picColor: white
window.button.focus: Flat
window.button.focus.color: rgb:1e/1e/1e
window.handle.focus: raised solid border
window.handle.focus.color: rgb:1e/1e/1e
window.grip.focus: raised solid border
window.grip.focus.color: rgb:3e/3e/3e
window.title.height: 30

window.title.unfocus: Raised
window.title.unfocus.color: rgb:60/60/60
window.button.unfocus: parentrelative
window.button.unfocus.foregroundColor: rgb:00/00/00
window.handle.unfocus: raised solid border
window.handle.unfocus.backgroundColor: rgb:60/60/60
window.grip.unfocus: raised solid border
window.grip.unfocus.backgroundColor: rgb:60/60/60
window.label.unfocus: parentrelative
window.label.unfocus.textColor: rgb:00/00/00
window.button.unfocus.picColor: rgb:00/00/00

window*justify: center
window.handleWidth: 8

*font: lucidasans-12
window.bevelWidth: 2
